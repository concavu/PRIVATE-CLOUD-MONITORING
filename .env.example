# ==============================================================================
# ENVIRONMENT VARIABLES - CONTAINERIZED PRIVATE CLOUD STORAGE
# ==============================================================================

# Domain & Host Configuration
DOMAIN_NAME=cloud.local
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD

# MariaDB Credentials
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_ROOT_PASSWORD
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD

# Redis Cache Credentials
REDIS_PASSWORD=REPLACE_WITH_A_UNIQUE_REDIS_PASSWORD

# MinIO Object Storage Credentials (S3 Compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_MINIO_PASSWORD
MINIO_BUCKET_NAME=nextcloud-data
MINIO_PORT=9000

# Subnet Configurations (CIDR)
FRONTEND_SUBNET=172.20.10.0/24
BACKEND_SUBNET=172.20.20.0/24
STORAGE_SUBNET=172.20.30.0/24

# Grafana credentials
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
